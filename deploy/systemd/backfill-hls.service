# systemd unit for the HLS self-heal backfill (re-encodes video posts whose
# background HLS task failed or was lost). Pairs with backfill-hls.timer.
# By default this ENQUEUES encodes to the Celery worker, so the worker +
# broker (REDIS_URL) must be running.
[Unit]
Description=HLS self-heal backfill (re-encode video posts missing hls_master)
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/backend
Environment=REDIS_URL=redis://127.0.0.1:6379/0
ExecStart=/usr/bin/bash /home/ubuntu/backend/scripts/run_backfill_hls.sh
